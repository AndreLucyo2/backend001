				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"seta variavel\", () => {\r",
									"    const message = pm.response.json().message;\r",
									"    const name = pm.response.json().user.name;\r",
									"    const email = pm.response.json().user.email;\r",
									"    const token = pm.response.json().token;\r",
									"    const uid = pm.response.json().user.uid;\r",
									"    pm.environment.set(\"EMAIL\", email);\r",
									"    pm.environment.set(\"NAME\", name);\r",
									"    pm.collectionVariables.set(\"ACCESS_TOKEN_IA\", token);\r",
									"    pm.environment.set(\"UID\", uid);\r",
									"    pm.environment.set(\"MSG\", message);\r",
									"});\r",
									"\r",
									"console.log(\"Token Env:\",pm.environment.get(\"ACCESS_TOKEN_IA\"));\r",
									"console.log(\"Token ColEnv:\",pm.collectionVariables.get(\"ACCESS_TOKEN_IA\"));"
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\r\n  \"email\": \"usuario@teste01.com\",\r\n  \"password\": \"123\"\r\n}",
